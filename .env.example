# =============================================================================
# Variáveis de ambiente — EXEMPLO
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais no .env (principalmente DB_PASSWORD)
#   3. NUNCA faça commit do .env (ele está no .gitignore)
#
# Onde é usado:
#   - docker-compose.yml (raiz)  → cria o Postgres e injeta as credenciais na app
#   - perfil "prod" da aplicação (application-prod.yml) → monta a URL JDBC a partir
#     de DB_HOST/DB_PORT/DB_NAME e autentica com DB_USER/DB_PASSWORD
#
# No servidor de produção, este arquivo fica na RAIZ do projeto (mesmo nível de onde
# você roda o `docker compose`), para que a interpolação ${...} funcione.
#
# REGRA DE FORMATAÇÃO: sem espaços ao redor do "=" (use DB_HOST=postgres, não DB_HOST = postgres).
# =============================================================================

# Imagem Docker publicada pelo GitHub Actions a cada push na main.
# Deve bater com a tag gerada em .github/workflows/deploy.yml:
#   ghcr.io/<owner-lowercase>/<repo-lowercase>:latest
APP_IMAGE=

# Banco de dados
DB_HOST=                 # nome do serviço Postgres na rede do compose
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# IA (FlashIA / CorretorIA / RoadmapIA)
# ATENÇÃO: a aplicação lê STUDYAI_AI_API_KEY — NÃO existe leitura de OPENAI_API_KEY.
# Sem STUDYAI_AI_API_KEY preenchida, a aplicação volta para o MODO DEMO em silêncio,
# mesmo com STUDYAI_AI_MODO=real (ver IAProperties.isDemo()).
# O modelo precisa ser do mesmo provedor: openai -> gpt-*, anthropic -> claude-*, gemini -> gemini-*.
STUDYAI_AI_MODO=demo
STUDYAI_AI_PROVEDOR=openai
STUDYAI_AI_API_KEY=
STUDYAI_AI_MODELO=gpt-4o-mini
STUDYAI_AI_TIMEOUT=120

# Login social (Google OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Observabilidade — OpenTelemetry -> Grafana central da disciplina
# =============================================================================
# O backend (Grafana/Loki/Tempo) é hospedado pelo professor. A app só aponta para lá.
# Para ATIVAR: mude OTEL_SDK_DISABLED para false e cole o token da turma (vem do Discord).
# NUNCA comite o token — este arquivo é só exemplo; o real fica no .env (gitignored).
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=dsc-eq11
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.dsc.rodrigor.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Formato exato (sem aspas): Authorization=Bearer SEU_TOKEN_AQUI
OTEL_EXPORTER_OTLP_HEADERS=

# =============================================================================
# Analytics de frontend — Umami
# =============================================================================
# Os valores reais da eq11 já são o default no docker-compose.yml (o website-id
# NÃO é segredo — fica visível no HTML). Só defina aqui se quiser sobrescrever
# (ex.: deixar em branco para desligar o analytics num ambiente de teste).
# UMAMI_SRC=
# UMAMI_WEBSITE_ID=
