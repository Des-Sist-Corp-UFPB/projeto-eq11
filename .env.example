# =============================================================================
# Variáveis de ambiente — EXEMPLO
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais no .env (principalmente DB_PASSWORD)
#   3. NUNCA faça commit do .env (ele está no .gitignore)
#
# Onde é usado:
#   - docker-compose.yml (raiz)  → cria o Postgres e injeta as credenciais na app
#   - perfil "prod" da aplicação (application-prod.yml) → monta a URL JDBC a partir
#     de DB_HOST/DB_PORT/DB_NAME e autentica com DB_USER/DB_PASSWORD
#
# No servidor de produção, este arquivo fica na RAIZ do projeto (mesmo nível de onde
# você roda o `docker compose`), para que a interpolação ${...} funcione.
#
# REGRA DE FORMATAÇÃO: sem espaços ao redor do "=" (use DB_HOST=postgres, não DB_HOST = postgres).
# =============================================================================

# Imagem Docker publicada pelo GitHub Actions a cada push na main.
# Deve bater com a tag gerada em .github/workflows/deploy.yml:
#   ghcr.io/<owner-lowercase>/<repo-lowercase>:latest
APP_IMAGE=

# Banco de dados
DB_HOST=                 # nome do serviço Postgres na rede do compose
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# OpenAi
OPENAI_API_KEY=
